# ==============================================================================
# SPDS / PRAGATIX BACKEND - LOCAL ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in the values for local development.
# NEVER commit the actual .env file with real credentials to Git.
# ==============================================================================

# Server Configuration
SERVER_PORT=8080

# Database Configuration
DB_URL=jdbc:mysql://localhost:3307/spdms_lab?useSSL=false&serverTimezone=Asia/Kolkata&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=

# JWT Authentication
JWT_SECRET=spdms_super_secret_key_must_be_at_least_256_bits_long_for_hs256_algorithm
JWT_EXPIRATION=86400000
JWT_STUDENT_EXPIRATION=43200000

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=https://pragatix.in,http://localhost:8080,http://localhost:5173

# SMS Test Configuration
SMS_TEST_ENDPOINT_ENABLED=true

# ==============================================================================
# ZEPTO MAIL CONFIGURATION
# ==============================================================================
ZEPTO_MAIL_URL=https://api.zeptomail.in/v1.1/email
ZEPTO_MAIL_TOKEN=
ZEPTO_MAIL_TEMPLATE_KEY=
ZEPTO_MAIL_SENDER_ADDRESS=noreply@pragatix.in
ZEPTO_MAIL_SENDER_NAME=Pragatix

# ==============================================================================
# AIRTEL IQ SMS CONFIGURATION
# ==============================================================================
AIRTEL_SMS_ENABLED=true
AIRTEL_SMS_URL=https://iqsms.airtel.in/api/v1/send-sms
AIRTEL_CUSTOMER_ID=
AIRTEL_USERNAME=
AIRTEL_PASSWORD=
AIRTEL_DLT_TEMPLATE_ID=
AIRTEL_ENTITY_ID=
AIRTEL_SOURCE_ADDRESS=JJECTR
AIRTEL_MESSAGE_TYPE=SERVICE_IMPLICIT
